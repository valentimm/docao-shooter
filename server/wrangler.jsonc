{
  // Docão Shooter — servidor online. Deploy: `npx wrangler deploy` nesta pasta.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "docao-shooter-server",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "Room" }, { "name": "TRUCO_ROOMS", "class_name": "TrucoRoom" }, { "name": "UNO_ROOMS", "class_name": "UnoRoom" }]
  },
  // plano grátis: Durable Objects precisam ser SQLite-backed
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }, { "tag": "v2", "new_sqlite_classes": ["TrucoRoom"] }, { "tag": "v3", "new_sqlite_classes": ["UnoRoom"] }],
  // Contas (login opcional). D1 de produção criado (docao-contas). Em `wrangler dev` o D1 é simulado local. Ver docs/LOGIN-DEPLOY.md
  "d1_databases": [{ "binding": "DB", "database_name": "docao-contas", "database_id": "992d49c8-9c5f-48e9-80d0-d79c595ae896", "migrations_dir": "migrations" }],
  "observability": { "enabled": true }
}
